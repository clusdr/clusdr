#!/usr/bin/env bash
# gofmt on staged Go files. Matches CONTRIBUTING: format changed .go before commit.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"

if ! command -v gofmt >/dev/null 2>&1; then
	echo "pre-commit: gofmt not in PATH" >&2
	exit 1
fi

files=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.go$' || true)
if [[ -z $files ]]; then
	exit 0
fi

unformatted=$(printf '%s\n' "$files" | xargs gofmt -l)
if [[ -n $unformatted ]]; then
	echo "pre-commit: gofmt needed:" >&2
	printf '%s\n' "$unformatted" >&2
	exit 1
fi
